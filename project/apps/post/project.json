{
  "name": "post",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/post/src",
  "projectType": "application",
  "targets": {
    
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "env": {
          "NODE_ENV": "production"
        },
        "cwd": "apps/post"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/post/package.json",
        "{workspaceRoot}/dist/apps/post/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/post/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "post:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "post:build:development"
        },
        "production": {
          "buildTarget": "post:build:production"
        }
      }
    },
        "db:lint": {
          "executor": "nx:run-commands",
          "options": {
            "command": "npx prisma validate --schema ./schema",
            "cwd": "libs/post/models/prisma"
          }
        },
        "db:migrate": {
          "executor": "nx:run-commands",
          "options": {
            "command": "npx prisma migrate dev --schema ./prisma/schema",
            "cwd": "libs/post/models"
          }
        },
        "db:generate": {
          "executor": "nx:run-commands",
          "options": {
            "command": "npx prisma generate --schema libs/post/models/prisma/schema/",
            "cwd": "."
          }
        },
        "db:seed": {
          "executor": "nx:run-commands",
          "options": {
            "command": "npx ts-node seed.ts",
            "cwd": "libs/post/models/prisma"
          }
        },
        "db:push": {
          "executor": "nx:run-commands",
          "options": {
            "command": "npx prisma db push --schema ./schema",
            "cwd": "libs/post/models/prisma"
          }
        },
        "db:reset": {
          "executor": "nx:run-commands",
          "options": {
            "command": "npx prisma migrate reset --force --schema ./prisma/schema",
            "cwd": "libs/post/models"
          }
        }
  },
  "tags": []
}

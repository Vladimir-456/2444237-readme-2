datasource db_post {
    provider = "postgresql"
}

enum PostType {
    VIDEO
    TEXT
    PHOTO
    QUOTE
    LINK
}

enum PostStatus {
    PUBLISHED
    DRAFT
}

model Post {
    id          String     @id @default(uuid())
    authorId    String     @map("author_id")
    tags        String[]
    status      PostStatus @default(DRAFT)
    isRepost    Boolean
    createdAt   DateTime   @default(now()) @map("created_at")
    updatedAt   DateTime   @updatedAt @map("updated_at")
    publishDate DateTime

    typePost PostType @default(TEXT) @map("type_post")
    title    String?
    url      String?
    preview  String?
    text     String?

    author      String?
    imageUrl    String?   @map("image_url")
    link        String?
    description String?
    comments    Comment[]
    likes       Like[]
    
    digestPosts DigestPost[]

    @@map("posts")
    postMailingItems PostMailingItem[]
}

enum PostMailingStatus {
  DRAFT
  PENDING
  PUBLISHED
  SENT
  FAILED
  COMPLETED
  CANCELLED
}

model PostMailing {
  id          String            @id @default(uuid())
  digestId    String
  title       String
  status      PostMailingStatus @default(PENDING)
  createdBy   String
  createdAt   DateTime          @default(now())
  publishedAt DateTime?
  sentAt      DateTime?

  digest Digest            @relation(fields: [digestId], references: [id])
  items  PostMailingItem[]

  @@map("post_mailing")
}

model PostMailingItem {
  id        String @id @default(uuid())
  mailingId String
  postId    String
  position  Int    @default(0)

  mailing PostMailing @relation(fields: [mailingId], references: [id], onDelete: Cascade)
  post    Post        @relation(fields: [postId], references: [id])
  digests Digest[]

  @@unique([mailingId, postId])
  @@index([mailingId, position])

  @@map("post_mailing_items")
}

model Digest {
    id String @id @default(uuid())
    title String
    createdAt DateTime @default(now())

    posts DigestPost[]
    postMailingItems PostMailingItem[]
    postMailings PostMailing[]

    @@map("digest")
}

model DigestPost {
  id       String @id @default(uuid())
  digestId String
  postId   String

  digest Digest @relation(fields: [digestId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id])

  @@unique([digestId, postId])
  @@map("digest_post")
}
